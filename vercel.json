{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "^/css/(.*)$",
      "dest": "/public/css/$1"
    },
    {
      "src": "^/js/(.*)$",
      "dest": "/public/js/$1"
    },
    {
      "src": "^/images/(.*)$",
      "dest": "/public/images/$1"
    },
    {
      "src": "^/img/(.*)$",
      "dest": "/public/img/$1"
    },
    {
      "src": "^/fonts/(.*)$",
      "dest": "/public/fonts/$1"
    },
    {
      "src": "^/build/(.*)$",
      "dest": "/public/build/$1"
    },
    {
      "src": "^/(.*\\.(ico|png|jpg|jpeg|svg|webp|gif|woff|woff2|ttf|map|pdf))$",
      "dest": "/public/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.php"
    }
  ]
}